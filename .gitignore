# Generated by Cargo
# will have compiled files and executables
debug
target

# `go build ./...` in go-shim/ with no -o writes a binary named after the
# package directory itself (this is a C-archive/plugin package normally
# only ever built via `go build -buildmode=c-archive`, cgo from Cargo, or
# `go vet`/`go build ./...` for a quick compile check) — never intended to
# be a real artifact.
go-shim/go-shim

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# vllm-plugin/ (Python) build/test artifacts
vllm-plugin/.venv
vllm-plugin/.pytest_cache
vllm-plugin/.ruff_cache
vllm-plugin/**/__pycache__
vllm-plugin/**/*.egg-info
vllm-plugin/dist
vllm-plugin/build

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# The web UI's binary assets are fetched by build.rs from the docs-assets
# GitHub release, never committed (see FETCHED_ASSETS in build.rs).
webui/**/*.png
webui/**/*.jpg
webui/**/*.gif
